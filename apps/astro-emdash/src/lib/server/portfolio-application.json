		},
		{
			"id": "experience",
			"headingId": "experience-title"
		},
		{
			"id": "education",
			"headingId": "education-title"
		},
		{
			"id": "tech",
			"headingId": "tech-title"
		},
		{
			"id": "contact",
			"headingId": null
		}
	],
	"projects": [
		{
			"id": "windows-pc-hardware",
			"accent": "sage"
		},
		{
			"id": "arch-linux",
			"accent": "sage"
		},
		{
			"id": "medal-of-honor-museum",
			"accent": "gold"
		},
		{
			"id": "first-avenue-advisors",
			"accent": "gold",
