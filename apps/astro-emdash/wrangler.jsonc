{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio-astro-emdash-local",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-astro-emdash-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"remote": false
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "portfolio-astro-emdash-media-local",
			"remote": false
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "00000000000000000000000000000000",
			"remote": false
		}
	]
}
