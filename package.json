{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:realtime": "wrangler dev -c workers/realtime/wrangler.jsonc --port 8788",
		"build": "vite build",
		"build:realtime": "wrangler deploy --dry-run -c workers/realtime/wrangler.jsonc --outdir .wrangler/build/realtime",
		"deploy": "pnpm build && wrangler deploy -c workers/realtime/wrangler.jsonc && wrangler deploy",
		"preview": "wrangler dev -c wrangler.jsonc -c workers/realtime/wrangler.jsonc --port 4173",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:worker": "vitest run --config vitest.worker.config.ts --maxWorkers=1 --no-isolate",
		"test": "pnpm test:unit && pnpm test:worker && pnpm test:e2e",
		"test:e2e": "playwright test",
		"gen": "pnpm gen:app && pnpm gen:realtime",
		"gen:app": "wrangler types",
		"gen:realtime": "wrangler types workers/realtime/worker-configuration.d.ts -c workers/realtime/wrangler.jsonc --env-interface RealtimeEnv --include-runtime false"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@cloudflare/vitest-pool-workers": "^0.18.7",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.23.0",
		"bits-ui": "^2.18.1",
		"marked": "^18.0.5",
		"zod": "^4.4.3"
	}
}
