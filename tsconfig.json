{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"vite.config.ts",
		"playwright.config.ts"
	],
	"exclude": ["node_modules", ".svelte-kit", "build", "worker-configuration.d.ts"]
}
